{
  "name": "compras-la-perla-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "build:prodsubdominio": "vue-tsc --noEmit -p tsconfig.app.json && vite build --mode prodsubdominio",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@mdi/font": "^7.4.47",
    "axios": "^1.7.9",
    "chart.js": "^4.5.1",
    "dayjs": "^1.11.13",
    "pinia": "^2.3.0",
    "vue": "3.5.39",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^4.5.0",
    "vuetify": "3.12.10"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "5.2.1",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "6.4.3",
    "vite-plugin-vuetify": "2.1.1",
    "vue-tsc": "^2.2.0"
  }
}
