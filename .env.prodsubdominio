# Entorno de PRODUCCIÓN con subdominio y HTTPS (lo usa `vite build --mode prodsubdominio`).
# Compilar con: npm run build:prodsubdominio
# Réplica del .env actual de prod. Dominio de ejemplo: compras.munilaperla.gob.pe
# -> reemplazar por el real. Los VITE_* se incorporan al compilar: si cambia el
# dominio hay que volver a compilar.
VITE_BASE_PATH=/
# CAMBIA (las tres): origen con https, sin puerto ni barra final. VITE_API_URL
# es la única que usa el código; VITE_APP_URL y VITE_BASE_URL no las lee nada
# (se dejan solo por ser réplica del .env actual).
VITE_APP_URL=https://compras.munilaperla.gob.pe
VITE_BASE_URL=https://compras.munilaperla.gob.pe
VITE_API_URL=https://compras.munilaperla.gob.pe
VITE_OUT_DIR=C:/laragon/www/compras/public
# AGREGADA: falta en el .env actual y AppBar.vue / RecuperarPasswordView.vue la
# leen sin valor por defecto (mostrarían "undefined").
VITE_APP_NOMBRE="Compras La Perla"
